                  "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Success message\", () => pm.expect(pm.response.text()).to.include('liked'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}/like",
              "host": ["{{baseUrl}}"], "path": ["api","posts","{{postId}}","like"]
            }
          }
        },
