{
  "info": {
    "_postman_id": "core-api-guardrails-v1",
    "name": "Core API Guardrails",
    "description": "Spring Boot microservice — Phase 1–4 endpoints covering Core API, Redis Virality Engine, Atomic Locks, and Notification Engine.\n\n**Base URL**: `http://localhost:8080`\n\n**Pre-requisites**:\n- Docker running: `docker-compose up -d`\n- Application running on port 8080\n- Seed at least one User (id=1), one Bot (id=1), and one Post (id=1) before running comment/like flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",  "value": "http://localhost:8080", "type": "string" },
    { "key": "postId",   "value": "1",                    "type": "string" },
    { "key": "userId",   "value": "1",                    "type": "string" },
    { "key": "botId",    "value": "1",                    "type": "string" }
  ],
  "item": [
    {
      "name": "Phase 1 — Core API",
      "description": "Standard REST endpoints: create posts, add comments, like posts.",
      "item": [
        {
          "name": "Create Post (User author)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Response has id\", () => pm.expect(json.id).to.be.a('number'));",
                  "pm.test(\"authorType is USER\", () => pm.expect(json.authorType).to.eql('USER'));",
                  "pm.collectionVariables.set('postId', json.id);",
                  "console.log('postId set to', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/posts", "host": ["{{baseUrl}}"], "path": ["api","posts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"authorId\": {{userId}},\n  \"authorType\": \"USER\",\n  \"content\": \"This is a user-authored test post created via Postman.\"\n}"
            }
          }
        },
        {
          "name": "Create Post (Bot author)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"authorType is BOT\", () => pm.expect(json.authorType).to.eql('BOT'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/posts", "host": ["{{baseUrl}}"], "path": ["api","posts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"authorId\": {{botId}},\n  \"authorType\": \"BOT\",\n  \"content\": \"This is a bot-authored post.\"\n}"
            }
          }
        },
        {
          "name": "Create Post — Validation Error (missing content)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 400 Bad Request\", () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/posts", "host": ["{{baseUrl}}"], "path": ["api","posts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"authorId\": {{userId}},\n  \"authorType\": \"USER\"\n}"
            }
          }
        },
        {
          "name": "Add Human Comment (depth 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"authorType is USER\", () => pm.expect(json.authorType).to.eql('USER'));",
                  "pm.test(\"depthLevel is 1\", () => pm.expect(json.depthLevel).to.eql(1));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}/comments",
              "host": ["{{baseUrl}}"], "path": ["api","posts","{{postId}}","comments"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"authorId\": {{userId}},\n  \"authorType\": \"USER\",\n  \"content\": \"Human comment at depth 1.\",\n  \"depthLevel\": 1\n}"
