              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 404 Not Found\", () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/999999/like",
              "host": ["{{baseUrl}}"], "path": ["api","posts","999999","like"]
            }
          }
