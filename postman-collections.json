          }
        },
        {
          "name": "Add Bot Comment (depth 1) — first reply",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"authorType is BOT\", () => pm.expect(json.authorType).to.eql('BOT'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}/comments",
              "host": ["{{baseUrl}}"], "path": ["api","posts","{{postId}}","comments"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"authorId\": {{botId}},\n  \"authorType\": \"BOT\",\n  \"content\": \"Bot reply at depth 1 — first interaction.\",\n  \"depthLevel\": 1\n}"
            }
          }
        },
        {
          "name": "Like a Post",
          "event": [
            {
